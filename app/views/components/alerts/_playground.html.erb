<div class="alert alert-<%= theme %> d-flex align-items-center justify-content-between" role="alert">
  <div class="d-flex align-items-center">
    <% if icon %>
      <%= image_tag 'alert.svg', class: "alert-icon me-2", alt: 'Alert svg' %>
    <% end %>
    <%= title %>
  </div>
  <% if dismissible %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  <% end %>
</div>
