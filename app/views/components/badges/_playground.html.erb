<% style = change_style ? 'rounded-pill' : '' %>
<% inline = inline ? '' : 'position-absolute top-0 start-100 translate-middle' %>

<span class='badge <%= style %> text-bg-<%= theme %>'><%= title %></span>

<div class='mt-5'>
  <button type='button' class='btn btn-primary position-relative'>
    <%= title %>
    <span class='badge <%= inline %> <%= style %> bg-<%= theme %>'>
      <%= body %>
    </span>
  </button>
</div>
