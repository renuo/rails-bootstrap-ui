<div>
  <div>
    <button type="button" class="btn btn-primary mt-3">Primary</button>
    <button type="button" class="btn btn-secondary mt-3">Secondary</button>
    <button type="button" class="btn btn-success mt-3">Success</button>
    <button type="button" class="btn btn-danger mt-3">Danger</button>
    <button type="button" class="btn btn-warning mt-3">Warning</button>
    <button type="button" class="btn btn-info mt-3">Info</button>
    <button type="button" class="btn btn-light mt-3">Light</button>
    <button type="button" class="btn btn-dark mt-3">Dark</button>
    <button type="button" class="btn btn-link mt-3">Link</button>
  </div>

  <div>
    <button type="button" class="btn btn-outline-primary mt-3">Primary</button>
    <button type="button" class="btn btn-outline-secondary mt-3">Secondary</button>
    <button type="button" class="btn btn-outline-success mt-3">Success</button>
    <button type="button" class="btn btn-outline-danger mt-3">Danger</button>
    <button type="button" class="btn btn-outline-warning mt-3">Warning</button>
    <button type="button" class="btn btn-outline-info mt-3">Info</button>
    <button type="button" class="btn btn-outline-light mt-3">Light</button>
    <button type="button" class="btn btn-outline-dark mt-3">Dark</button>
    <button type="button" class="btn btn-outline-link mt-3">Link</button>
  </div>

  <div>
    <button type="button" class="btn btn-primary btn-lg mt-3">Large button</button>
    <button type="button" class="btn btn-secondary btn-lg mt-3">Large button</button>
  </div>

  <div>
    <button type="button" class="btn btn-primary btn-sm mt-3">Small button</button>
    <button type="button" class="btn btn-secondary btn-sm mt-3">Small button</button>
  </div>

  <div>
    <button type="button" class="btn btn-primary mt-3"
            style="--bs-btn-padding-y: .25rem; --bs-btn-padding-x: .5rem; --bs-btn-font-size: .75rem;">
      Custom button
    </button>
  </div>

  <div>
    <button type="button" class="btn btn-primary mt-3" disabled>Primary button</button>
    <button type="button" class="btn btn-secondary mt-3" disabled>Button</button>
    <button type="button" class="btn btn-outline-primary mt-3" disabled>Primary button</button>
    <button type="button" class="btn btn-outline-secondary mt-3" disabled>Button</button>
  </div>

  <div>
    <div class="d-grid gap-2">
      <button class="btn btn-primary mt-3" type="button">Button</button>
      <button class="btn btn-primary mt-3" type="button">Button</button>
    </div>
  </div>

  <div>
    <p class="d-inline-flex gap-1">
      <button type="button" class="btn mt-3" data-bs-toggle="button">Toggle button</button>
      <button type="button" class="btn active mt-3" data-bs-toggle="button" aria-pressed="true">Active toggle button</button>
      <button type="button" class="btn mt-3" disabled data-bs-toggle="button">Disabled toggle button</button>
    </p>
    <p class="d-inline-flex gap-1">
      <button type="button" class="btn btn-primary mt-3" data-bs-toggle="button">Toggle button</button>
      <button type="button" class="btn btn-primary active mt-3" data-bs-toggle="button" aria-pressed="true">Active toggle
        button
      </button>
      <button type="button" class="btn btn-primary mt-3" disabled data-bs-toggle="button">Disabled toggle button</button>
    </p>
  </div>
</div>
