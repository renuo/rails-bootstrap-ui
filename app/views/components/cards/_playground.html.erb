<div class="card p-4 border-none" style="width: <%= width %>">
  <div class="row">
    <div class="col-9">
      <div class="pill-wrapper pill-fs-small pill-thin mb-3">Go somewhere</div>
      <div class="card-body">
        <h5 class="card-title"><%= title %></h5>
        <p class="card-text"><%= body %></p>
      </div>
    </div>
    <div class="col-3">
      <%= image_tag "example_image.avif", class: "card-img-top rounded-5", alt: "Placeholder Image" %>
    </div>
  </div>
</div>
